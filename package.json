{
  "name": "qingqie",
  "version": "0.1.0",
  "description": "轻切 - 前端切图工具",
  "main": "./out/main/index.js",
  "author": "daihongkun",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "gen:icon": "node scripts/gen-icon.mjs && node scripts/gen-ico.mjs",
    "dist": "electron-vite build && node scripts/dist-retry.mjs",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.daihongkun.qingqie",
    "productName": "轻切",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@webtoon/psd": "^0.4.0",
    "ag-psd": "^29.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "patch-package": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
